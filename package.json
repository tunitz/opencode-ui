{
  "name": "@tunitz/opencode-ui",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.0",
  "description": "Mobile-first web client for an OpenCode V2 engine.",
  "license": "MIT",
  "author": "tunitz",
  "homepage": "https://github.com/tunitz/opencode-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tunitz/opencode-ui.git"
  },
  "keywords": [
    "opencode",
    "web-client",
    "bun",
    "react",
    "typescript"
  ],
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "plugins/notes"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "bin": {
    "opencode-ui": "bin/opencode-ui.ts"
  },
  "files": [
    "bin/opencode-ui.ts",
    "server/bun-server.ts",
    "server/bun-config.ts",
    "server/bun-application.ts",
    "server/agent-config.ts",
    "server/artifact-delivery.ts",
    "server/project-artifacts.ts",
    "server/notifications.ts",
    "server/pty-websocket-bridge.ts",
    "server/request-security.ts",
    "server/web-dispatch.ts",
    "server/web-gateway.ts",
    "server/web-proxy.ts",
    "server/web-security.ts",
    "server/web-static.ts",
    "server/auth.ts",
    "server/auth-api.ts",
    "server/cli-flags.ts",
    "server/notes-api.ts",
    "server/plugins-api.ts",
    "src/lib/agent-config-types.ts",
    "plugins/notes/*.ts",
    "plugins/notes/package.json",
    "plugins/notes/README.md",
    "plugins/notes/src/",
    "dist-bun-build/",
    "docs/",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "dev": "bun scripts/dev-bun.mjs",
    "dev:bun": "bun scripts/dev-bun.mjs",
    "start": "bun server/bun-server.ts",
    "build": "tsc -b && bun scripts/build-bun.ts",
    "build:bun": "bun scripts/build-bun.ts",
    "prepack": "OPENCODE_UI_BUILD_TARGET=production bun run build:bun",
    "start:bun": "bun server/bun-server.ts",
    "test": "bun test tests --isolate",
    "test:bun": "bun run build:bun && bun test tests --isolate",
    "test:browser": "bun tests/browser/run.ts",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b && tsc --noEmit -p plugins/notes/tsconfig.json",
    "preview": "bun server/bun-server.ts",
    "icons:generate": "bun scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@lexical/react": "^0.53.0",
    "@opencode/client": "2.1.4",
    "@openuidev/react-ui": "0.18.1",
    "@tunitz/opencode-notes": "workspace:*",
    "@tanstack/react-virtual": "^3.14.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "jsonc-parser": "3.3.1",
    "lexical": "^0.53.0",
    "lucide-react": "1.61.0",
    "mdast-util-from-markdown": "2.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "unified": "^11.0.5",
    "web-push": "3.6.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "@types/web-push": "3.6.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-test-renderer": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
