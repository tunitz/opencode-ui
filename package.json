{
  "name": "opencode-ui",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "bin": {
    "opencode-ui": "bin/opencode-ui.ts"
  },
  "files": [
    "bin/opencode-ui.ts",
    "server/bun-server.ts",
    "server/bun-config.ts",
    "server/bun-application.ts",
    "server/agent-config.ts",
    "server/artifact-delivery.ts",
    "server/notifications.ts",
    "server/pty-websocket-bridge.ts",
    "server/request-security.ts",
    "server/web-dispatch.ts",
    "server/web-gateway.ts",
    "server/web-proxy.ts",
    "server/web-security.ts",
    "server/web-static.ts",
    "src/lib/agent-config-types.ts",
    "dist-bun-build/",
    "README.md"
  ],
  "scripts": {
    "dev": "bun scripts/dev-bun.mjs",
    "dev:bun": "bun scripts/dev-bun.mjs",
    "build": "tsc -b && bun scripts/build-bun.ts",
    "build:bun": "bun scripts/build-bun.ts",
    "prepack": "OPENCODE_UI_BUILD_TARGET=production bun run build:bun",
    "start:bun": "bun server/bun-server.ts",
    "test:bun": "bun run build:bun && bun test server/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b",
    "preview": "bun server/bun-server.ts",
    "icons:generate": "$HOME/.bun/bin/bun scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/geist": "5.3.0",
    "@opencode/client": "2.1.4",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-virtual": "^3.14.22",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "jsonc-parser": "3.3.1",
    "lucide-react": "1.61.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "yaml": "2.9.1",
    "zod": "4.6.7",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
