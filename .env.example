# Local environment template. Copy to `.env` or export these variables.
# Never commit real credentials or private state.

# Server binding
OPENCODE_UI_HOST=127.0.0.1
OPENCODE_UI_PORT=5174

# Direct Bun server only. The CLI ignores these and uses
# --allowed-host / --allowed-origin. Comma-separated; non-loopback
# bindings require at least one non-loopback value.
OPENCODE_UI_ALLOWED_HOSTS=
OPENCODE_UI_ALLOWED_ORIGINS=

# Dev server browser origin (direct server only)
OPENCODE_UI_DEV_ORIGIN=

# Artifact delivery roots. Comma-separated absolute paths; empty disables delivery.
OPENCODE_UI_ARTIFACT_ROOTS=

# Web Push contact and private notification state
OPENCODE_UI_VAPID_SUBJECT=mailto:opencode-ui@localhost
OPENCODE_UI_NOTIFICATION_STATE=

# UI password/session state (defaults to ~/.local/share/opencode-ui/auth/state.json)
OPENCODE_UI_AUTH_STATE=

# Notes data directory (defaults to $XDG_DATA_HOME/opencode-notes/v1)
OPENCODE_NOTES_DATA_DIR=

# Legacy engine database read once for the notes migration
# (defaults to $XDG_DATA_HOME/opencode/opencode.db)
OPENCODE_ENGINE_DB_PATH=

# Build target: production (default) or dev
OPENCODE_UI_BUILD_TARGET=production

# Agent configuration directory (defaults to $XDG_CONFIG_HOME/opencode or ~/.config/opencode)
OPENCODE_CONFIG_DIR=
